# Optional SQLite URL. Default database is in the project working directory.
AGENTSHIELD_DB=sqlite:///agentshield.db
# Optional real-model CLI uses an explicitly supplied local Ollama model name.
# No API keys or cloud services are needed. .env is not auto-loaded.
AGENTSHIELD_MODEL=qwen3:0.6b
AGENTSHIELD_OLLAMA_URL=http://127.0.0.1:11434/api/chat
# Local defaults. Public pilot setup is documented in docs/deployment.md.
AGENTSHIELD_PUBLIC=0
AGENTSHIELD_PUBLIC_REGISTRATION=0
AGENTSHIELD_ENABLE_REAL_MODEL=1
# PUBLIC mode requires HTTPS AGENTSHIELD_PUBLIC_ORIGIN (or RENDER_EXTERNAL_URL)
# and a DATABASE_URL secret supplied in the hosting dashboard, never source control.
